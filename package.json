{
  "name": "openprefs",
  "version": "0.1.0-beta.2",
  "description": "Natural-language preferences for existing apps: text in, validated preference changes out.",
  "keywords": [
    "preferences",
    "settings",
    "natural-language",
    "headless",
    "typescript",
    "semantic-layer",
    "ai"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kgudipati/OpenPrefs.git"
  },
  "homepage": "https://github.com/kgudipati/OpenPrefs#readme",
  "bugs": {
    "url": "https://github.com/kgudipati/OpenPrefs/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs/architecture.md",
    "skills/openprefs-integrate/SKILL.md",
    "skills/openprefs-integrate/eval.md",
    "skills/openprefs-integrate/references"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tests.json && tsc --noEmit --project evals/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:skill-package",
    "verify:skill-package": "node scripts/verify-skill-package.mjs",
    "evals:build": "tsup --config evals/tsup.config.ts",
    "evals": "npm run evals:build && node .evals-dist/cli.js keyword",
    "evals:hosted": "npm run evals:build && node .evals-dist/cli.js hosted"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
